# Optional Gemini model override (defaults to gemini-4-hydrogen)
UNSENT_MODEL=gemini-4-hydrogen

# Optional Prokerala credentials for Vedic Moon (Lahiri) calculation
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Optional Firebase Web configuration (for optional cloud backup & Google sign-in)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
