rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/closed/$(uid));
    }
    match /users/{uid}/letters/{id} {
      allow get, delete: if owner(uid);
      allow list: if owner(uid) && request.query.limit <= 50;
      allow create: if owner(uid)
        && id.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasOnly(['v','iv','cipher','createdAt'])
        && request.resource.data.v == 1
        && request.resource.data.iv is bytes && request.resource.data.iv.size() == 12
        && request.resource.data.cipher is bytes
        && request.resource.data.cipher.size() >= 17
        && request.resource.data.cipher.size() <= 262144
        && request.resource.data.createdAt == request.time;
    }
  }
}
